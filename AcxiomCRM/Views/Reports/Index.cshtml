@model AcxiomCRM.ViewModels.ReportsDashboardViewModel
@{
    ViewData["Title"] = "CRM Analytics & Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-graph-up text-primary me-2"></i>Executive Reports & Intelligence</h3>
        <p class="text-muted small mb-0">Role-scoped reporting on pipelines, conversion ratios, customer master, and follow-ups</p>
    </div>
    <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Print / Export Report
    </button>
</div>

<!-- Report Navigation Tabs -->
<ul class="nav nav-pills mb-4" id="reportTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "Pipeline" ? "active" : "")" asp-action="Index" asp-route-tab="Pipeline">
            <i class="bi bi-bar-chart-steps me-1"></i> Pipeline Report
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "Conversion" ? "active" : "")" asp-action="Index" asp-route-tab="Conversion">
            <i class="bi bi-arrow-repeat me-1"></i> Lead Conversion
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "Customers" ? "active" : "")" asp-action="Index" asp-route-tab="Customers">
            <i class="bi bi-people me-1"></i> Customer Master
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "FollowUps" ? "active" : "")" asp-action="Index" asp-route-tab="FollowUps">
            <i class="bi bi-calendar-check me-1"></i> Follow-Up Audits
        </a>
    </li>
</ul>

@if (Model.ActiveTab == "Pipeline")
{
    <!-- Pipeline Report -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card card-custom p-3 border-start border-4 border-success">
                <span class="text-muted small text-uppercase">Total Active Pipeline</span>
                <h3 class="fw-bold text-success mb-0">&#8377;@Model.TotalPipelineValue.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-custom p-3 border-start border-4 border-primary">
                <span class="text-muted small text-uppercase">Total Weighted Pipeline</span>
                <h3 class="fw-bold text-primary mb-0">&#8377;@Model.TotalWeightedPipelineValue.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">Stage-Wise Pipeline Breakdown</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Pipeline Stage</th>
                        <th>Opportunities Count</th>
                        <th>Total Value (INR)</th>
                        <th>Weighted Value (INR)</th>
                        <th>Contribution</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stage in Model.StagePipelineSummaries)
                    {
                        var pct = Model.TotalPipelineValue > 0 ? (stage.TotalAmount * 100 / Model.TotalPipelineValue) : 0;
                        <tr>
                            <td class="fw-bold">@stage.Stage</td>
                            <td><span class="badge bg-secondary">@stage.Count Deals</span></td>
                            <td class="fw-semibold text-success">&#8377;@stage.TotalAmount.ToString("N0")</td>
                            <td class="fw-semibold text-primary">&#8377;@stage.WeightedAmount.ToString("N0")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width: @pct%"></div>
                                    </div>
                                    <span class="small">@pct.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.ActiveTab == "Conversion")
{
    <!-- Lead Conversion & Outcome Report -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card card-custom p-3">
                <span class="text-muted small text-uppercase">Total Captured Leads</span>
                <h4 class="fw-bold mb-0">@Model.TotalLeadsCount</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-custom p-3">
                <span class="text-muted small text-uppercase">Converted into Customers</span>
                <h4 class="fw-bold mb-0 text-success">@Model.ConvertedLeadsCount</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-custom p-3">
                <span class="text-muted small text-uppercase">Conversion Rate</span>
                <h4 class="fw-bold mb-0 text-primary">@Model.ConversionRate.ToString("F1")%</h4>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-custom p-3">
                <span class="text-muted small text-uppercase">Closed Won Deals</span>
                <h4 class="fw-bold mb-0 text-success">&#8377;@Model.WonAmount.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">Conversion Details</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Lead Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Converted Customer ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td><code>@l.LeadCode</code></td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td>@l.Source</td>
                            <td>
                                @if (l.Status == "Converted")
                                {
                                    <span class="badge bg-success">Converted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@l.Status</span>
                                }
                            </td>
                            <td>
                                @if (l.ConvertedCustomerId.HasValue)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId.Value" class="text-decoration-none fw-bold">
                                        Customer #@l.ConvertedCustomerId.Value &rarr;
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.ActiveTab == "Customers")
{
    <!-- Customer Report -->
    <div class="card card-custom">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">Customer Master Directory Report</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td><code>@c.CustomerCode</code></td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@(c.City ?? "-"), @(c.State ?? "-")</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                            <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.ActiveTab == "FollowUps")
{
    <!-- Follow-Ups Report -->
    <div class="card card-custom">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">Follow-Up Execution Audit Report</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Scheduled Date</th>
                        <th>Type</th>
                        <th>Associated Contact</th>
                        <th>Remarks</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.FollowUps)
                    {
                        <tr>
                            <td>@f.FollowUpDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <span>@f.Customer.CustomerName (Customer)</span>
                                }
                                else if (f.Lead != null)
                                {
                                    <span>@f.Lead.LeadName (Lead)</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@f.Remarks</td>
                            <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
