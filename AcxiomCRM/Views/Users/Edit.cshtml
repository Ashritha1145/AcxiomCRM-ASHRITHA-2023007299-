@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-danger me-2"></i>Edit User: @Model.Email</h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address</label>
                        <input class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold small">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select"></select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <small class="text-muted">Changing user role will immediately update their CRM scope and write an audit event.</small>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="chkIsActive" />
                        <label class="form-check-label fw-semibold" for="chkIsActive">Account Active (Can log in)</label>
                    </div>

                    <div class="border-top pt-3 mt-3">
                        <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-key me-1"></i>Administrative Password Reset</h6>
                        <div class="mb-2">
                            <label asp-for="NewPassword" class="form-label small"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Leave empty to retain existing password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
