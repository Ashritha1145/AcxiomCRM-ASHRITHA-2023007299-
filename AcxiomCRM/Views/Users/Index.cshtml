@model AcxiomCRM.ViewModels.UserIndexViewModel
@{
    ViewData["Title"] = "User & Access Administration";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-danger me-2"></i>User & Role Administration</h3>
        <p class="text-muted small mb-0">Admin control for user identities, roles (Admin/Manager/SalesExecutive), and account lockouts</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add New User
    </a>
</div>

<!-- Search & Role Filter -->
<div class="card card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search user name or email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Manager</option>
                    <option value="SalesExecutive" selected="@(Model.RoleFilter == "SalesExecutive")">SalesExecutive</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-link text-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Lockout Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">
                            <i class="bi bi-person-circle me-1 text-secondary"></i> @u.FullName
                        </td>
                        <td class="small">@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge badge-role-admin">Admin</span>
                            }
                            else if (u.Role == "Manager")
                            {
                                <span class="badge badge-role-manager">Manager</span>
                            }
                            else
                            {
                                <span class="badge badge-role-sales">SalesExecutive</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deactivated</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger" title="Locked until @u.LockoutEnd">
                                    <i class="bi bi-lock-fill me-1"></i> Locked Out
                                </span>
                            }
                            else if (u.AccessFailedCount > 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    @u.AccessFailedCount / 5 failed attempts
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-success border border-success">Normal</span>
                            }
                        </td>
                        <td class="small text-muted">@u.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (u.IsLockedOut)
                            {
                                <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" title="Unlock Account">
                                        <i class="bi bi-unlock-fill me-1"></i> Unlock
                                    </button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit User">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
