@model AcxiomCRM.ViewModels.FollowUpIndexViewModel
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Follow-Up Schedule</h3>
        <p class="text-muted small mb-0">Schedule client meetings, calls, and track engagement status</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Follow-up Counters -->
<div class="row g-2 mb-3">
    <div class="col-sm-4">
        <div class="card card-custom p-3 border-start border-4 border-warning">
            <span class="text-muted small text-uppercase">Planned Engagements</span>
            <h4 class="fw-bold mb-0 text-warning">@Model.PlannedCount</h4>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <span class="text-muted small text-uppercase">Completed</span>
            <h4 class="fw-bold mb-0 text-success">@Model.CompletedCount</h4>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-custom p-3 border-start border-4 border-danger">
            <span class="text-muted small text-uppercase">Overdue</span>
            <h4 class="fw-bold mb-0 text-danger">@Model.OverdueCount</h4>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="typeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Demo" selected="@(Model.TypeFilter == "Demo")">Demo</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="dateFilter" class="form-select">
                    <option value="">All Dates</option>
                    <option value="Today" selected="@(Model.DateFilter == "Today")">Today</option>
                    <option value="Upcoming" selected="@(Model.DateFilter == "Upcoming")">Upcoming</option>
                    <option value="Overdue" selected="@(Model.DateFilter == "Overdue")">Overdue</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-link text-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Date & Time</th>
                    <th>Type</th>
                    <th>Associated Contact / Company</th>
                    <th>Remarks</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Any())
                {
                    foreach (var f in Model.FollowUps)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.UtcNow.Date;
                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td class="fw-semibold small @(isOverdue ? "text-danger" : "")">
                                @f.FollowUpDate.ToString("dd MMM yyyy HH:mm")
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                            <td class="small">
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="fw-semibold text-decoration-none">
                                        <i class="bi bi-building text-primary me-1"></i>@f.Customer.CustomerName
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="fw-semibold text-decoration-none">
                                        <i class="bi bi-funnel text-info me-1"></i>@f.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">General Follow-Up</span>
                                }
                            </td>
                            <td class="small">@f.Remarks</td>
                            <td>
                                @if (f.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (f.Status == "Planned")
                                {
                                    <span class="badge bg-warning text-dark">Planned</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@f.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (f.Status == "Planned")
                                {
                                    <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success py-1" title="Mark Done">
                                            <i class="bi bi-check-lg me-1"></i> Complete
                                        </button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x fs-3 d-block mb-1"></i> No follow-ups found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-dateFilter="@Model.DateFilter">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
