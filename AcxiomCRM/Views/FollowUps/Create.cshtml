@model AcxiomCRM.ViewModels.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule Client Follow-Up</h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="followUpForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Related Customer (Optional)</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- None / Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Related Lead (Optional)</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- None / Select Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold small">Follow-Up Date & Time <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" id="followUpDateInput" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold small">Engagement Channel <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Meeting (In-person / Virtual)</option>
                                <option value="Email">Email Communication</option>
                                <option value="Demo">Product Demo</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Remarks" class="form-label fw-semibold small">Agenda & Notes</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Discuss contract renewal, proposal clarifications, technical requirements..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-calendar-check me-1"></i> Confirm Schedule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('followUpForm').addEventListener('submit', function(e) {
            const dateInput = document.getElementById('followUpDateInput').value;
            if (dateInput) {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const chosenDate = new Date(dateInput);
                if (chosenDate < today) {
                    alert("Follow-up date cannot be earlier than today.");
                    e.preventDefault();
                    return;
                }
            }
        });
    </script>
}
