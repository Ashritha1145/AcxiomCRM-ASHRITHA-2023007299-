@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = "Opportunity: " + Model.Opportunity.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>@Model.Opportunity.OpportunityName</h3>
        <span class="badge @(Model.Opportunity.Stage == "Won" ? "bg-success" : Model.Opportunity.Stage == "Lost" ? "bg-danger" : "bg-primary")">@Model.Opportunity.Stage</span>
        <span class="badge bg-secondary ms-1">Status: @Model.Opportunity.Status</span>
        <span class="text-muted small ms-2">Assigned to: @Model.AssignedToName &bull; Created: @Model.Opportunity.CreatedDate.ToString("dd MMM yyyy")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-light border">&larr; Back to Pipeline</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h5 class="fw-bold mb-0">Deal Valuation & Financials</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-3">
                        <strong class="text-muted d-block">Contract Value:</strong>
                        <span class="fs-4 fw-bold text-success">&#8377;@Model.Opportunity.Amount.ToString("N0")</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-muted d-block">Close Probability:</strong>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <div class="progress flex-grow-1" style="height: 10px;">
                                <div class="progress-bar @(Model.Opportunity.Probability >= 70 ? "bg-success" : Model.Opportunity.Probability >= 40 ? "bg-warning" : "bg-info")"
                                     style="width: @Model.Opportunity.Probability%"></div>
                            </div>
                            <span class="fw-bold">@Model.Opportunity.Probability%</span>
                        </div>
                    </li>
                    <li class="mb-3">
                        <strong class="text-muted d-block">Weighted Pipeline Value (Amount &times; Probability):</strong>
                        <span class="fs-5 fw-bold text-primary">&#8377;@Model.Opportunity.WeightedValue.ToString("N0")</span>
                    </li>
                    <li class="mb-2">
                        <strong class="text-muted d-block">Target Close Date:</strong>
                        <span class="fs-6">@Model.Opportunity.ExpectedCloseDate.ToString("dd MMMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h5 class="fw-bold mb-0">Associated Records & Notes</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-3">
                        <strong class="text-muted d-block">Customer Master:</strong>
                        @if (Model.Opportunity.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId" class="fw-bold text-decoration-none">
                                <i class="bi bi-building me-1"></i>@Model.Opportunity.Customer.CustomerName (@Model.Opportunity.Customer.CustomerCode)
                            </a>
                        }
                    </li>
                    <li class="mb-3">
                        <strong class="text-muted d-block">Originating Lead:</strong>
                        @if (Model.Opportunity.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.Opportunity.LeadId" class="fw-bold text-decoration-none">
                                <i class="bi bi-funnel me-1"></i>@Model.Opportunity.Lead.LeadName (@Model.Opportunity.Lead.LeadCode)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Direct / Inbound Opportunity</span>
                        }
                    </li>
                    <li class="mb-2">
                        <strong class="text-muted d-block">Strategy Notes:</strong>
                        <p class="p-2 bg-light rounded mt-1 mb-0">@(string.IsNullOrWhiteSpace(Model.Opportunity.Notes) ? "No notes recorded." : Model.Opportunity.Notes)</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
