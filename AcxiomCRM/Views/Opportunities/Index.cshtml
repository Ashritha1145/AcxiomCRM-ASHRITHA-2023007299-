@model AcxiomCRM.ViewModels.OpportunityIndexViewModel
@{
    ViewData["Title"] = "Opportunities & Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>Sales Opportunities</h3>
        <p class="text-muted small mb-0">Track deals, pipeline stages, probability weighting, and outcomes</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Opportunity
    </a>
</div>

<!-- Pipeline Metrics Bar -->
<div class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-2 px-3">
            <span class="text-muted small text-uppercase">Total Pipeline</span>
            <h5 class="fw-bold mb-0 text-success">&#8377;@Model.TotalPipelineValue.ToString("N0")</h5>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-2 px-3">
            <span class="text-muted small text-uppercase">Weighted Pipeline</span>
            <h5 class="fw-bold mb-0 text-primary">&#8377;@Model.WeightedPipelineValue.ToString("N0")</h5>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-2 px-3">
            <span class="text-muted small text-uppercase">Closed Won</span>
            <h5 class="fw-bold mb-0 text-success">@Model.WonCount Deals</h5>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-custom p-2 px-3">
            <span class="text-muted small text-uppercase">Closed Lost</span>
            <h5 class="fw-bold mb-0 text-danger">@Model.LostCount Deals</h5>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4 col-lg-3">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search opportunity or customer..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="stageFilter" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-4 col-lg-3">
                <select name="customerFilter" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in Model.CustomersList)
                    {
                        <option value="@c.Value" selected="@(Model.CustomerFilter?.ToString() == c.Value)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-link text-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Deal Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted</th>
                    <th>Target Close</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    foreach (var opp in Model.Opportunities)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                    @opp.OpportunityName
                                </a>
                            </td>
                            <td>
                                @if (opp.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-decoration-none">
                                        @opp.Customer.CustomerName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="fw-bold text-success">&#8377;@opp.Amount.ToString("N0")</td>
                            <td>
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0" type="button" data-bs-toggle="dropdown">
                                        @opp.Stage
                                    </button>
                                    <ul class="dropdown-menu shadow-sm">
                                        <li>
                                            <form asp-action="UpdateStage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@opp.OpportunityId" />
                                                <input type="hidden" name="stage" value="Qualification" />
                                                <button type="submit" class="dropdown-item">Qualification</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="UpdateStage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@opp.OpportunityId" />
                                                <input type="hidden" name="stage" value="Proposal" />
                                                <button type="submit" class="dropdown-item">Proposal</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="UpdateStage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@opp.OpportunityId" />
                                                <input type="hidden" name="stage" value="Negotiation" />
                                                <button type="submit" class="dropdown-item">Negotiation</button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="UpdateStage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@opp.OpportunityId" />
                                                <input type="hidden" name="stage" value="Won" />
                                                <button type="submit" class="dropdown-item text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Mark Won</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="UpdateStage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@opp.OpportunityId" />
                                                <input type="hidden" name="stage" value="Lost" />
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-x-circle me-1"></i> Mark Lost</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar @(opp.Probability >= 70 ? "bg-success" : opp.Probability >= 40 ? "bg-warning" : "bg-info")"
                                             role="progressbar" style="width: @opp.Probability%"></div>
                                    </div>
                                    <span class="small">@opp.Probability%</span>
                                </div>
                            </td>
                            <td class="small fw-semibold text-secondary">&#8377;@opp.WeightedValue.ToString("N0")</td>
                            <td class="small @(opp.ExpectedCloseDate.Date < DateTime.UtcNow.Date && opp.Status == "Active" ? "text-danger fw-bold" : "text-muted")">
                                @opp.ExpectedCloseDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                        onclick="confirmDeleteOpp(@opp.OpportunityId, '@opp.OpportunityName')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i> No opportunities found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter">&laquo;</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Delete Opportunity Modal -->
<div class="modal fade" id="deleteOppModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Opportunity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete opportunity <strong id="modalOppName"></strong>?
                <p class="text-muted small mt-2 mb-0">This permanently removes the deal and writes an audit log entry.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteOppForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalOppId" />
                    <button type="submit" class="btn btn-danger">Delete Deal</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDeleteOpp(id, name) {
            document.getElementById('modalOppId').value = id;
            document.getElementById('modalOppName').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('deleteOppModal'));
            modal.show();
        }
    </script>
}
