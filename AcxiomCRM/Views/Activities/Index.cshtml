@model AcxiomCRM.ViewModels.ActivityIndexViewModel
@{
    ViewData["Title"] = "Activity Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Activity History & Tasks</h3>
        <p class="text-muted small mb-0">Record and track calls, meetings, emails, and client tasks</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Log Activity
    </a>
</div>

<!-- Search & Filters -->
<div class="card card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search subject, description, contact..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="typeFilter" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-link text-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Associated With</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Activities.Any())
                {
                    foreach (var act in Model.Activities)
                    {
                        <tr>
                            <td class="small fw-semibold">@act.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (act.ActivityType == "Call")
                                {
                                    <span class="badge bg-primary"><i class="bi bi-telephone me-1"></i>Call</span>
                                }
                                else if (act.ActivityType == "Meeting")
                                {
                                    <span class="badge bg-success"><i class="bi bi-people me-1"></i>Meeting</span>
                                }
                                else if (act.ActivityType == "Email")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-envelope me-1"></i>Email</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-check2-square me-1"></i>Task</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@act.Subject</div>
                                @if (!string.IsNullOrWhiteSpace(act.Description))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 350px;">@act.Description</small>
                                }
                            </td>
                            <td class="small">
                                @if (act.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@act.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-building text-primary me-1"></i>@act.Customer.CustomerName
                                    </a>
                                }
                                else if (act.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@act.LeadId" class="text-decoration-none">
                                        <i class="bi bi-funnel text-info me-1"></i>@act.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">General</span>
                                }
                            </td>
                            <td>
                                @if (act.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (act.Status == "In Progress")
                                {
                                    <span class="badge bg-warning text-dark">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@act.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@act.ActivityId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@act.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity entry?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i> No activities recorded.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-typeFilter="@Model.TypeFilter" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
