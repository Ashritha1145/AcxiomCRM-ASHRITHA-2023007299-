@model AcxiomCRM.ViewModels.ActivityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Activity</h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ActivityId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold small">Type</label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold small">Date & Time</label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Subject" class="form-label fw-semibold small">Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- None / Select Customer --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Related Lead</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- None / Select Lead --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold small">Detailed Summary</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Update Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
