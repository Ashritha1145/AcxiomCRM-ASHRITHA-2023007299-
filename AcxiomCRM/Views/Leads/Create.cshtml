@model AcxiomCRM.ViewModels.LeadCreateEditViewModel
@{
    ViewData["Title"] = "Add New Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0"><i class="bi bi-funnel text-primary me-2"></i>New Prospect Lead</h4>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="leadForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="LeadCode" class="form-label fw-semibold small">Lead Code <span class="text-danger">*</span></label>
                            <input asp-for="LeadCode" class="form-control" />
                            <span asp-validation-for="LeadCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="LeadName" class="form-label fw-semibold small">Lead Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="e.g. Reliance Retail Digital" />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="contact@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Phone (10-Digit Mobile) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="e.g. 9876543210" maxlength="10" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small">Company / Organization</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Company Name" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold small">Lead Source</label>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website Inbound</option>
                                <option value="Referral">Referral / Word of Mouth</option>
                                <option value="Cold Call">Cold Outreach</option>
                                <option value="Social Media">Social Media / LinkedIn</option>
                                <option value="Email Campaign">Email Marketing</option>
                                <option value="Event">Event / Trade Show</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">Initial Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                                <option value="Unqualified">Unqualified</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold small">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small">Expected Value (INR)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">&#8377;</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="1000" min="0" max="100000000" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Save Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
