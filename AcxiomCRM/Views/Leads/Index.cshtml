@model AcxiomCRM.ViewModels.LeadIndexViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-funnel text-primary me-2"></i>Leads</h3>
        <p class="text-muted small mb-0">Capture, qualify, assign and convert prospective leads</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Lead
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card card-custom mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search lead name, code, company, email..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(Model.StatusFilter == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="col-md-3 col-lg-3">
                    <select name="assignedToFilter" class="form-select">
                        <option value="">All Assignees</option>
                        @foreach (var u in Model.UsersList)
                        {
                            <option value="@u.Value" selected="@(Model.AssignedToFilter == u.Value)">@u.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-link text-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Email / Phone</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Exp. Value</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    foreach (var lead in Model.Leads)
                    {
                        <tr>
                            <td class="fw-bold small"><code>@lead.LeadCode</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-semibold text-decoration-none">
                                    @lead.LeadName
                                </a>
                                @if (lead.Priority == "High")
                                {
                                    <span class="badge bg-danger ms-1" style="font-size: 0.7rem;">High</span>
                                }
                            </td>
                            <td>@(lead.CompanyName ?? "-")</td>
                            <td class="small">
                                <div>@lead.Email</div>
                                <div class="text-muted">@lead.Phone</div>
                            </td>
                            <td class="small"><span class="badge bg-light text-dark border">@lead.Source</span></td>
                            <td>
                                @if (lead.Status == "New")
                                {
                                    <span class="badge bg-primary">New</span>
                                }
                                else if (lead.Status == "Contacted")
                                {
                                    <span class="badge bg-info text-dark">Contacted</span>
                                }
                                else if (lead.Status == "Qualified")
                                {
                                    <span class="badge bg-warning text-dark">Qualified</span>
                                }
                                else if (lead.Status == "Converted")
                                {
                                    <span class="badge bg-success">Converted</span>
                                }
                                else if (lead.Status == "Lost")
                                {
                                    <span class="badge bg-danger">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@lead.Status</span>
                                }
                            </td>
                            <td class="fw-semibold small">&#8377;@lead.ExpectedValue.ToString("N0")</td>
                            <td class="text-end">
                                @if (lead.Status == "Qualified")
                                {
                                    <a asp-action="Convert" asp-route-id="@lead.LeadId" class="btn btn-sm btn-success py-1" title="Convert to Customer & Deal">
                                        <i class="bi bi-arrow-repeat me-1"></i> Convert
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (lead.Status != "Converted")
                                {
                                    <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                            onclick="confirmDeleteLead(@lead.LeadId, '@lead.LeadName')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i> No leads found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalCount)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">&laquo;</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">@p</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Delete Lead Modal -->
<div class="modal fade" id="deleteLeadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete lead <strong id="modalLeadName"></strong>?
                <p class="text-muted small mt-2 mb-0">This permanently removes the lead and logs an audit record.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteLeadForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalLeadId" />
                    <button type="submit" class="btn btn-danger">Delete Lead</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDeleteLead(id, name) {
            document.getElementById('modalLeadId').value = id;
            document.getElementById('modalLeadName').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('deleteLeadModal'));
            modal.show();
        }
    </script>
}
