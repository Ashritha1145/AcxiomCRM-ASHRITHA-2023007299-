@model AcxiomCRM.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer: " + Model.Customer.CustomerName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i>@Model.Customer.CustomerName</h3>
        <span class="badge @(Model.Customer.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Customer.Status</span>
        <span class="text-muted small ms-2"><code>@Model.Customer.CustomerCode</code> &bull; Created @Model.Customer.CreatedDate.ToString("dd MMM yyyy") by @Model.CreatedByName</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-success"><i class="bi bi-plus-lg me-1"></i> Add Deal</a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-warning text-dark"><i class="bi bi-calendar-plus me-1"></i> Follow-Up</a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-info text-dark"><i class="bi bi-journal-plus me-1"></i> Log Activity</a>
        <a asp-action="Index" class="btn btn-sm btn-light border">&larr; Back</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Contact Info Card -->
    <div class="col-md-4">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h5 class="fw-bold mb-0">Contact & Company Profile</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><strong class="text-muted d-block">Company:</strong> @(Model.Customer.CompanyName ?? "-")</li>
                    <li class="mb-2"><strong class="text-muted d-block">Email:</strong> <a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></li>
                    <li class="mb-2"><strong class="text-muted d-block">Phone:</strong> @Model.Customer.Phone</li>
                    <li class="mb-2"><strong class="text-muted d-block">Location:</strong> @(Model.Customer.City ?? "-"), @(Model.Customer.State ?? "-")</li>
                    <li class="mb-2"><strong class="text-muted d-block">Address:</strong> @(Model.Customer.Address ?? "-")</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Opportunities -->
    <div class="col-md-8">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-briefcase text-primary me-2"></i>Opportunities (@Model.Opportunities.Count)</h5>
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-link text-decoration-none">+ New Deal</a>
            </div>
            <div class="card-body p-0 pt-2">
                @if (Model.Opportunities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Opportunity</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Close Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="fw-semibold">@opp.OpportunityName</td>
                                        <td><span class="badge bg-primary">@opp.Stage</span></td>
                                        <td class="fw-bold text-success">&#8377;@opp.Amount.ToString("N0")</td>
                                        <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary py-0">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No opportunities linked with this customer yet.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Follow-Ups and Activities Tabs -->
<div class="card card-custom">
    <div class="card-header bg-white border-bottom">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#followupsTab" type="button">
                    <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#activitiesTab" type="button">
                    <i class="bi bi-card-checklist me-1"></i> Activities & History (@Model.Activities.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-0">
        <div class="tab-content">
            <div class="tab-pane fade show active" id="followupsTab">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Remarks</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td>@f.FollowUpDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                                        <td>@f.Remarks</td>
                                        <td>
                                            @if (f.Status == "Completed")
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Planned</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (f.Status == "Planned")
                                            {
                                                <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Mark Complete">Done</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No follow-ups scheduled.</div>
                }
            </div>

            <div class="tab-pane fade" id="activitiesTab">
                @if (Model.Activities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Activities)
                                {
                                    <tr>
                                        <td>@a.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td><span class="badge bg-info text-dark">@a.ActivityType</span></td>
                                        <td class="fw-semibold">@a.Subject</td>
                                        <td>@(a.Description ?? "-")</td>
                                        <td><span class="badge bg-light text-dark border">@a.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
