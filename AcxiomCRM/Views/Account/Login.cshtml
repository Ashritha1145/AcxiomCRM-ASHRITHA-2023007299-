@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 text-center">
                <div class="mb-2">
                    <i class="bi bi-shield-lock-fill text-primary display-5"></i>
                </div>
                <h4 class="fw-bold mb-1">AcxiomCRM Sign In</h4>
                <p class="text-muted small">Enter your credentials to access your account</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@acxiom.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Remember this browser</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary fw-semibold py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>

                    <div class="text-center small text-muted">
                        Don't have an account? <a asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Evaluator Quick Fill helper -->
        <div class="card card-custom mt-3 bg-light border-0">
            <div class="card-body p-3">
                <div class="small fw-bold text-secondary mb-2"><i class="bi bi-info-circle me-1"></i> Quick Test Credentials (Password: <code>Test@1234</code>)</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="fillCreds('admin@acxiom.com')">Admin</button>
                    <button type="button" class="btn btn-sm btn-outline-warning text-dark" onclick="fillCreds('manager@acxiom.com')">Manager</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="fillCreds('sales@acxiom.com')">Sales Exec</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = 'Test@1234';
        }
    </script>
}
